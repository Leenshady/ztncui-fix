extends controller_layout

block content
  h1!= title

  h2 ZeroTier network controller UI

  .alert.alert-info
    | Maintenance fork: the upstream project is no longer updated. Bug fixes and compatibility updates are applied in this repository.

  if error
     b #{error}
  else
    h4 This network controller has a ZeroTier address of <b>#{zt_status.address}</b>
    h4 ZeroTier version <b>#{zt_status.version}</b>
    h4
      a(href='/controller/networks') List all networks on this network controller
